<% layout("/layouts/boilerplate") %>

<!-- <h3>Listing Details</h3> -->

<div class="card col-6 offset-3 pt-5">
    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">

    <div class="card-body">
        <strong><h5 class="card-title"><%= listing.title %></h5></strong>

        <p class="card-text">
            <%= listing.description %>
        </p>

        <p class="card-text">
            ₹ <%= listing.price.toLocaleString("en-IN") %>
        </p>

        <p class="card-text">
            <%= listing.location %>, <%= listing.country %>
        </p>

        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
            Edit Listing
        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            class="d-inline"
        >
            <button class="btn btn-danger ms-4">
                Delete
            </button>
        </form>
    </div>
</div>